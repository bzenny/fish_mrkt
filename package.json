{
  "name": "fishmrkt",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @fishmrkt/web dev",
    "build": "pnpm --filter @fishmrkt/web build",
    "typecheck": "tsc --noEmit && pnpm --filter @fishmrkt/web typecheck",
    "test": "vitest run",
    "db:generate": "pnpm --filter @fishmrkt/database db:generate",
    "db:migrate": "pnpm --filter @fishmrkt/database db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@types/node": "^22.0.0"
  }
}
